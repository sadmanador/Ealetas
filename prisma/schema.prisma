datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  phone     String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id            String           @id @default(cuid())
  name          String
  slug          String           @unique
  description   String           @db.Text
  price         Float
  wholesaleCost Float            @default(0)
  category      String
  tags          String           @default("")
  quantity      Int              @default(0) // total across variants or base
  images        String           @db.Text    // legacy/main preview image JSON
  commonImages  String           @default("[]") @db.Text // up to 2 common images
  isFeatured       Boolean           @default(false)
  variants         ProductVariant[]
  orderItems       OrderItem[]
  procurementItems ProcurementItem[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model ProductVariant {
  id               String            @id @default(cuid())
  productId        String
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorName        String
  colorCode        String?           // optional hex code (e.g. #0f388a)
  quantity         Int               @default(0)
  images           String            @default("[]") @db.Text // variant-specific images JSON
  orderItems       OrderItem[]
  procurementItems ProcurementItem[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Customer {
  id            String   @id @default(cuid())
  phone         String   @unique
  name          String
  division      String
  district      String
  upazila       String
  fullAddress   String   @db.Text
  isBlacklisted Boolean  @default(false)
  isFraudRisk   Boolean  @default(false)
  fraudNotes    String?  @db.Text
  orders        Order[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Order {
  id                String               @id @default(cuid())
  orderNumber       String               @unique
  customerId        String
  customer          Customer             @relation(fields: [customerId], references: [id])
  status            String               @default("pending") // pending, confirmed, packaged, in_transit, delivered, cancelled, returned
  subtotal          Float
  deliveryCharge    Float
  totalAmount       Float
  totalCost         Float                @default(0) // wholesale items + packaging costs
  isDhakaCityCorp   Boolean              @default(false)
  deliveryAddress   String               @db.Text
  customerPhone     String
  customerName      String
  notes             String?
  inventoryAdjusted Boolean              @default(false)
  items             OrderItem[]
  packagingItems    OrderPackagingItem[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model OrderItem {
  id               String          @id @default(cuid())
  orderId          String
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  productName      String
  colorVariantName String?
  productImage     String?
  price            Float
  wholesaleCost    Float           @default(0)
  quantity         Int             @default(1)
}

model OrderPackagingItem {
  id              String        @id @default(cuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  packagingItemId String
  packagingItem   PackagingItem @relation(fields: [packagingItemId], references: [id], onDelete: Cascade)
  quantity        Int           @default(1)
  unitPrice       Float         @default(0)
  totalCost       Float         @default(0)
  createdAt       DateTime      @default(now())
}

model PackagingItem {
  id             String               @id @default(cuid())
  sku            String               @unique
  name           String
  dimensions     String?
  description    String?              @db.Text
  unitPrice      Float                @default(0)
  quantity       Int                  @default(0)
  batches        PackagingBatch[]
  orderPackagings OrderPackagingItem[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model PackagingBatch {
  id              String        @id @default(cuid())
  packagingItemId String
  packagingItem   PackagingItem @relation(fields: [packagingItemId], references: [id], onDelete: Cascade)
  quantity        Int
  unitPrice       Float
  totalCost       Float
  supplier        String?
  notes           String?       @db.Text
  receivedDate    DateTime      @default(now())
  createdAt       DateTime      @default(now())
}

model ProcurementLog {
  id                   String            @id @default(cuid())
  title                String?           // e.g., 'Tanti Bazar Jewelry Run - Oct 2026'
  date                 DateTime          @default(now())
  transportCost        Float             @default(0)
  foodCost             Float             @default(0)
  wholesaleProductCost Float             @default(0) // auto-calculated sum of all items in this run
  otherCost            Float             @default(0)
  totalCost            Float             @default(0) // transport + food + other + wholesaleProductCost
  supplier             String?           // supplier or market name
  notes                String?           @db.Text
  items                ProcurementItem[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

model ProcurementItem {
  id               String          @id @default(cuid())
  procurementLogId String
  procurementLog   ProcurementLog  @relation(fields: [procurementLogId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  name             String
  category         String          @default("Jewelry")
  colorName        String?
  colorCode        String?
  quantity         Int             @default(1)
  unitPrice        Float           @default(0) // Wholesale purchase price per unit
  totalCost        Float           @default(0) // quantity * unitPrice
  isEnlisted       Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  productId String?
  createdAt DateTime @default(now())
}

model StoreSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model CmsPage {
  id        String   @id @default(cuid())
  slug      String   @unique // 'words-from-founder', 'terms-and-conditions', 'return-policy'
  title     String
  content   String   @db.Text // HTML from TipTap
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
